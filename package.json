{
  "name": "react-online-store",
  "version": "1.2.0",
  "description": "react online store",
  "main": "app.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node app.js",
    "servdev": "cross-env NODE_ENV=development nodemon app.js",
    "servstartdev": "cross-env NODE_ENV=development node app.js",
    "client": "npm run start --prefix client",
    "client:install": "npm install --prefix client",
    "client:build": "npm run build --prefix client",
    "client:update": "npm update --prefix client",
    "clientdev": "cross-env PORT=3200 REACT_APP_NAME=react-online-store npm run client",
    "dev": "concurrently \"npm run servdev\" \"npm run clientdev\"",
    "srvstartcldev": "concurrently \"npm run servstartdev\" \"npm run clientdev\"",
    "geoip-lite:updatedb": "node ./node_modules/geoip-lite/scripts/updatedb.js license_key=YOUR_MAXMIND_LICENSE_KEY"
  },
  "keywords": [
    "react",
    "store"
  ],
  "author": "Berestov Aleksey <alekseyber@users.noreply.github.com>",
  "license": "ISC",
  "dependencies": {
    "apollo-server-express": "^3.4.0",
    "axios": "^0.24.0",
    "axios-oauth-client": "^1.4.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.2",
    "cross-fetch": "^3.1.4",
    "email-templates": "^8.0.8",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.1.0",
    "geoip-lite": "^1.4.2",
    "graphql": "^15.7.2",
    "graphql-type-json": "^0.3.2",
    "js-md5": "^0.7.3",
    "moment": "^2.29.1",
    "mongoose": "^6.0.12",
    "multer": "^1.4.3",
    "passport": "^0.5.0",
    "passport-jwt": "^4.0.0",
    "pdfmake": "^0.1.68",
    "pug": "^3.0.2",
    "require-all": "^3.0.0",
    "sharp": "^0.29.2",
    "sitemap": "^7.0.0",
    "xlsx": "^0.17.3",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "concurrently": "^6.3.0",
    "nodemon": "^2.0.6",
    "typescript": "^4.4.4"
  }
}
